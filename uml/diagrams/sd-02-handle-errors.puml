@startuml sd-02-handle-errors
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam style strictuml
skinparam linetype ortho
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 11
skinparam ArrowColor #000000
skinparam ArrowFontColor #000000
skinparam TitleFontColor #000000
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #000000
skinparam NoteFontColor #000000
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 10
skinparam BoxPadding 10
skinparam SequenceLifeLineBorderColor #000000
skinparam SequenceGroupBorderColor #000000
skinparam SequenceGroupBackgroundColor #FFFFFF
skinparam SequenceGroupFontColor #000000
skinparam SequenceGroupHeaderFontColor #000000
skinparam SequenceDividerBackgroundColor #FFFFFF
skinparam SequenceDividerBorderColor #000000
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #000000
skinparam ParticipantFontColor #000000
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #000000
skinparam ActorFontColor #000000
hide footbox
title SD-02. Обработка ошибок экспорта (расширение SD-01, UC-07)

actor "Игрок" as P

box "Frontend (браузер)" #FFFFFF
  participant "Кнопка\nExportPdfButton" as UI <<boundary>>
  participant "Файловая система\nпользователя" as FS <<boundary>>
end box

box "Backend (Spring Boot)" #FFFFFF
  participant "CharacterExport\nController" as API <<control>>
  participant "SheetExport\nService" as SVC <<control>>
  participant "TypstRenderer\nClient" as RC
end box

participant "Typst Renderer" as R <<system>>

P -> UI : нажать «Export to PDF»
activate UI
UI -> FS : showSaveFilePicker(имя файла)
activate FS
FS --> UI : FileSystemFileHandle
deactivate FS

UI -> API : GET /characters/{id}/export/pdf\nAuthorization: Bearer JWT
activate API

alt JWT отсутствует или недействителен
  API --> UI : 401 ApiResponse
else персонаж не найден или чужой
  API --> UI : 404 ApiResponse
else запрос авторизован
  API -> SVC : export(characterId)
  activate SVC

  alt нет свободного слота генерации
    SVC --> API : SheetExportException(BUSY)
  else слот получен
    SVC -> RC : render(SheetModel, portrait)
    activate RC
    RC -> R : POST /internal/v1/render\n(manifest, portrait, service token)
    activate R

    alt Renderer отклонил запрос
      R --> RC : 400, 401, 413 или 422
      RC --> SVC : RenderException(BAD_REQUEST)
    else Renderer недоступен
      R --> RC : 503 или нет соединения
      RC --> SVC : RenderException(UNAVAILABLE)
    else таймаут компиляции
      R -> R : остановить typst\nи удалить рабочий каталог
      R --> RC : 504
      RC --> SVC : RenderException(TIMEOUT)
    else ошибка компиляции или некорректный PDF
      R -> R : удалить рабочий каталог
      R --> RC : 500 (sanitized)
      RC --> SVC : RenderException(RENDER_FAILED)
    end

    deactivate R
    deactivate RC
  end

  SVC -> SVC : записать метрику failure\nи событие журнала (requestId, код)
  SVC --> API : SheetExportException(kind)
  deactivate SVC
  API --> UI : 503, 504 или 500 ApiResponse\nбез технических деталей
end
deactivate API

opt запись файла уже открыта
  UI -> FS : abort()
  activate FS
  FS --> UI : запись отменена
  deactivate FS
end

UI -> UI : state = Failed → Idle
UI --> P : toast «Не удалось создать PDF.\nПовторите попытку.»
deactivate UI
@enduml
