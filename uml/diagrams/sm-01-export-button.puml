@startuml sm-01-export-button
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam style strictuml
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 14
skinparam ArrowColor #000000
skinparam ArrowFontColor #000000
skinparam TitleFontColor #000000
skinparam TitleFontSize 18
skinparam TitleFontStyle bold
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #000000
skinparam NoteFontColor #000000
skinparam state {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
  StartColor #000000
  EndColor #000000
}
title SM-01. Состояния кнопки «Export to PDF»
hide empty description

[*] --> Disabled : компонент создан,\nперсонаж не загружен

state "Disabled\n(Недоступна)" as Disabled
state "Idle\n(Готова)" as Idle
state "ChoosingLocation\n(Выбор места)" as ChoosingLocation
state "Busy\n(Выполнение)" as Busy
state "Failed\n(Ошибка)" as Failed

Disabled --> Idle : персонаж загружен
Idle --> Disabled : персонаж выгружен
Idle --> ChoosingLocation : нажатие «Export to PDF»\n[диалог поддерживается]
Idle --> Busy : нажатие «Export to PDF»\n[диалог не поддерживается]
ChoosingLocation --> Idle : отмена
ChoosingLocation --> Busy : место выбрано
Busy --> Idle : файл записан\n/ toast «PDF сохранён»
Busy --> Failed : ошибка\n(правки, сеть, 401/404/5xx)
Failed --> Idle : закрытие уведомления\n/ таймаут
@enduml
