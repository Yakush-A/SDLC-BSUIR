@startuml sm-02-render-job
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam style strictuml
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 14
skinparam ArrowColor #000000
skinparam ArrowFontColor #000000
skinparam TitleFontColor #000000
skinparam TitleFontSize 18
skinparam TitleFontStyle bold
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #000000
skinparam NoteFontColor #000000
skinparam state {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
  StartColor #000000
  EndColor #000000
}
title SM-02. Состояния задания рендеринга
hide empty description

[*] --> Received : POST /internal/v1/render
state "Received\n(Получено)" as Received
state "Validating\n(Проверка)" as Validating
state "WaitingForSlot\n(Ожидание слота)" as WaitingForSlot
state "Rejected\n(Отклонено)" as Rejected
state "Job\n(Задание)" as Job
state "Completed\n(Завершено)" as Completed
state "Failed\n(Ошибка)" as Failed
state "TimedOut\n(Таймаут)" as TimedOut

Received --> Validating
Validating --> Rejected : данные недопустимы
Validating --> WaitingForSlot : данные допустимы
WaitingForSlot --> Rejected : слот недоступен
WaitingForSlot --> Job : слот получен
Job --> Completed : PDF корректен
Job --> Failed : ошибка записи,\nкомпиляции или PDF
Job --> TimedOut : время > 12 с
Rejected --> [*]
Completed --> [*]
Failed --> [*]
TimedOut --> [*]
@enduml
