@startuml sd-01-export-pdf
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam style strictuml
skinparam linetype ortho
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 11
skinparam ArrowColor #000000
skinparam ArrowFontColor #000000
skinparam TitleFontColor #000000
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #000000
skinparam NoteFontColor #000000
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 10
skinparam BoxPadding 10
skinparam SequenceLifeLineBorderColor #000000
skinparam SequenceGroupBorderColor #000000
skinparam SequenceGroupBackgroundColor #FFFFFF
skinparam SequenceGroupFontColor #000000
skinparam SequenceGroupHeaderFontColor #000000
skinparam SequenceDividerBackgroundColor #FFFFFF
skinparam SequenceDividerBorderColor #000000
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #000000
skinparam ParticipantFontColor #000000
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #000000
skinparam ActorFontColor #000000
hide footbox
title SD-01. Успешный экспорт листа персонажа в PDF (UC-01)

actor "Игрок" as P

box "Frontend (браузер)" #FFFFFF
  participant "Кнопка\nExportPdfButton" as UI <<boundary>>
  participant "Файловая система\nпользователя" as FS <<boundary>>
end box

box "Backend (Spring Boot)" #FFFFFF
  participant "CharacterExport\nController" as API <<control>>
  participant "SheetExport\nService" as SVC <<control>>
  participant "DndSheet\nProvider" as DND
  participant "Portrait\nLoader" as PL
  participant "TypstRenderer\nClient" as RC
end box

participant "Typst Renderer" as R <<system>>

P -> UI : нажать «Export to PDF»
activate UI

UI -> FS : showSaveFilePicker(имя файла)
activate FS
alt игрок отменил диалог
  FS --> UI : AbortError
  deactivate FS
  UI --> P : кнопка снова активна
else файл выбран
  FS --> UI : FileSystemFileHandle
  deactivate FS

  UI -> UI : сохранить отложенные правки
  UI -> API : GET /characters/{id}/export/pdf\nAuthorization: Bearer JWT
  activate API
  API -> API : проверить JWT и владельца

  alt запрос завершился ошибкой
    ref over API, SVC, RC, R : SD-02. Обработка ошибок
    deactivate API
  else запрос успешен
    API -> SVC : export(characterId)
    activate SVC
    SVC -> SVC : acquire(slot),\nожидание до 10 с

    SVC -> DND : build(character)
    activate DND
    DND --> SVC : SheetModel
    deactivate DND

    opt задан portraitUrl
      SVC -> PL : load(portraitUrl)
      activate PL
      PL --> SVC : проверенные байты\nили Placeholder
      deactivate PL
    end

    SVC -> RC : render(SheetModel, portrait)
    activate RC
    RC -> R : POST /internal/v1/render\n(manifest, portrait, service token)
    activate R
    note right of R
      Renderer проверяет токен и templateId,
      создаёт рабочий каталог, запускает
      typst compile и удаляет каталог
      после финализации PDF.
    end note
    R --> RC : 200 application/pdf
    deactivate R
    RC --> SVC : PDF
    deactivate RC

    SVC -> SVC : записать метрики\nи событие журнала
    SVC --> API : PDF
    deactivate SVC

    API --> UI : 200 application/pdf\nContent-Disposition: attachment
    deactivate API

    UI -> FS : createWritable().write(pdf).close()
    activate FS
    FS --> UI : файл записан
    deactivate FS
    UI --> P : toast «PDF сохранён»
  end
end
deactivate UI
@enduml
