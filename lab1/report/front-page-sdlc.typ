#page(
  numbering: none,
  paper: "a4",
  margin: (
    top: 2cm,
    bottom: 2cm,
    right: 1.5cm,
    left: 3cm,
  ),
)[

  #show: set text(
    font: "Times New Roman",
    size: 14pt,
    top-edge: 1em,
    bottom-edge: 0em,
    hyphenate: true,
    lang: "ru",
  )
  #show: set par(
    justify: true,
    leading: 4pt, 
    spacing: 4pt,

    first-line-indent: 0em,
  )

  
  #align(center)[
    Министерство образования Республики Беларусь \
    Учреждение образования \
    «БЕЛОРУССКИЙ ГОСУДАРСТВЕННЫЙ УНИВЕРСИТЕТ \
    ИНФОРМАТИКИ И РАДИОЭЛЕКТРОНИКИ»
  ]
  #v(1.0em)
  Факультет: Компьютерных систем и сетей
  #v(1.0em)
  Кафедра: Электронных вычислительных машин
  #v(1.0em)
  Дисциплина: Жизненный цикл разработки программного обеспечения

  #v(10.0em)

  #align(center)[
    ОТЧЕТ \
    О ЛАБОРАТОРНОЙ РАБОТЕ №1 \
    на тему \
    «ИНТЕГРИРОВАННАЯ СРЕДА РАЗРАБОТКИ ПО» \
    Вариант 26
  ]
  #v(10.0em)


  #grid(
    columns: (3fr, 1fr),
    [
      Студент:
      #v(1.0em)
      Преподаватель:
    ],
    [
      А.П. Якуш
      #v(1.0em)
      Д.В. Куприянова
    ]
  )

  #v(1.0fr)
  #align(center)[Минск 2026]
]
